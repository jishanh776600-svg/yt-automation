# ==========================================
# HISTORY SHORTS PIPELINE CONFIGURATION ($0)
# ==========================================

# Mode (true: validates & renders locally without public publishing; false: publishes to YouTube)
TEST_MODE=true

# API Keys ($0 Free Tiers)
GEMINI_API_KEY=
PEXELS_API_KEY=

# YouTube Data API v3 (OAuth 2.0 Credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
CLIENT_SECRETS_FILE=client_secret.json

# TTS Settings (kokoro, edge)
TTS_PROVIDER=kokoro
KOKORO_VOICE=am_adam

# AI Image Generation Provider (pollinations, huggingface, gemini)
IMAGE_PROVIDER=pollinations

# Scheduling (Number of Shorts per day)
SHORTS_PER_DAY=2
