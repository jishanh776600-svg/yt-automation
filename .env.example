# ==============================================================================
# Historia Autonomous Pipeline - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your genuine credentials.
# NEVER commit the real .env file or real secrets to git.

# ------------------------------------------------------------------------------
# 1. SYSTEM & OPERATION MODES
# ------------------------------------------------------------------------------
TEST_MODE=false
CLOUD_MODE=false
PORT=8000

# ------------------------------------------------------------------------------
# 2. OPERATOR DASHBOARD AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$your_salt_here$your_hash_here
SESSION_SECRET=generate_a_random_32_byte_hex_string_here

# ------------------------------------------------------------------------------
# 3. REMOTE GITHUB ACTIONS DISPATCHER (For Mobile Cloud Execution)
# ------------------------------------------------------------------------------
GITHUB_PAT=ghp_your_personal_access_token_with_actions_write_scope
GITHUB_REPOSITORY_OWNER=your_github_username_or_org
GITHUB_REPOSITORY_NAME=your_repository_name
GITHUB_REF=main

# ------------------------------------------------------------------------------
# 4. EXTERNAL AI & MEDIA APIS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD / YOUTUBE / DRIVE OAUTH CREDENTIALS
# ------------------------------------------------------------------------------
# In local development: place client_secret.json and token.json in project root.
# In cloud deployment: store these JSON payloads in cloud secret manager.
TOKEN_JSON={"token": "...", "refresh_token": "...", "token_uri": "https://oauth2.googleapis.com/token", "client_id": "...", "client_secret": "...", "scopes": ["https://www.googleapis.com/auth/youtube.upload", "https://www.googleapis.com/auth/drive"]}
CLIENT_SECRET_JSON={"installed": {"client_id": "...", "project_id": "...", "auth_uri": "https://accounts.google.com/o/oauth2/auth", "token_uri": "https://oauth2.googleapis.com/token", "client_secret": "..."}}