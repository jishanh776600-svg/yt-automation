# Python
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/

# Secrets (Protected - Injected via GitHub Secrets in Cloud)
token.json
client_secret.json
.env
show_secrets.py

# Large Model Weights (Downloaded on-the-fly by Kokoro / HF)
data/*.onnx
data/*.bin
*.onnx
*.bin

# Media Caches (Render outputs are temporary)
data/renders/
data/voice/
data/visuals/
data/assets/
data/captions/

# Temporary test audio and logs
*.log
stage_*.wav
test_*.wav
test_*.aac
*.mp4
*.db-shm
*.db-wal

# Database (Persisted Privately in Google Drive 00_SYSTEM/ - Never tracked in Git)
data/database/*
!data/database/.gitkeep
*.db
*.db-*
*.prev_backup

# Keep empty structure
!data/database/.gitkeep
!assets/music/*.wav
!assets/music/*.mp3
